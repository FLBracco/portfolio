---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="border-b border-border/60">
	<div
		class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5"
	>
		<a href="#inicio" class="text-sm font-bold tracking-tight">Fabricio Bracco</a>
		<nav class="flex items-center gap-6">
			<a
				href="#proyectos"
				class="hidden text-sm text-muted transition-colors duration-150 ease-out hover:text-fg sm:inline"
			>
				Proyectos
			</a>
			<a
				href="#contacto"
				class="hidden text-sm text-muted transition-colors duration-150 ease-out hover:text-fg sm:inline"
			>
				Contacto
			</a>
			<ThemeToggle />
		</nav>
	</div>
</header>
