---
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero-bg.png";

const GITHUB_URL = "https://github.com/FLBracco";
const EMAIL = "braccof.0601@gmail.com";
---

<section id="inicio" class="relative overflow-hidden">
	<div class="absolute inset-0 hidden md:block">
		<Image
			src={heroBg}
			alt=""
			role="presentation"
			widths={[800, 1200, 1920]}
			sizes="100vw"
			loading="eager"
			class="h-full w-full object-cover object-right"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-bg from-15% via-bg/85 via-45% to-transparent"></div>
	</div>

	<div class="relative mx-auto max-w-5xl px-6 py-24 sm:py-32">
		<p class="text-sm font-medium text-accent">Desarrollador de Software</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-6xl">
			Fabricio Bracco
		</h1>
		<p class="mt-6 max-w-xl text-lg text-muted">
			Construyo aplicaciones web de punta a punta — APIs, bases de datos y
			frontend — con foco en código simple y mantenible.
		</p>

		<div class="mt-10 flex flex-wrap items-center gap-4">
			<a
				href="#proyectos"
				class="inline-flex items-center gap-2 rounded border border-accent bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg transition-opacity duration-150 ease-out hover:opacity-90"
			>
				Ver proyectos
				<span aria-hidden="true">→</span>
			</a>
			<a
				href="#contacto"
				class="inline-flex items-center gap-2 rounded border border-border/70 px-5 py-2.5 text-sm font-semibold text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent"
			>
				Contactar
			</a>
		</div>

		<div class="mt-12 flex flex-wrap items-center gap-6 text-sm text-muted">
			<a
				href={GITHUB_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 transition-colors duration-150 ease-out hover:text-accent"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
					<path
						d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
					></path>
				</svg>
				GitHub
			</a>
			<a
				href={`mailto:${EMAIL}`}
				class="inline-flex items-center gap-2 transition-colors duration-150 ease-out hover:text-accent"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
					<rect x="2" y="4" width="20" height="16" rx="2"></rect>
					<path d="m22 6-10 7L2 6"></path>
				</svg>
				Email
			</a>
		</div>
	</div>
</section>
